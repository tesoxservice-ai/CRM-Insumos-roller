# =============================================
# CRM Insumos Roller — Variables de entorno
# =============================================
# Copiá este archivo como .env.local y completá los valores.
# NUNCA subas .env.local al repositorio.

# URL pública del proyecto Supabase (compartida con el configurador de cortinas)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anónima pública de Supabase (safe para exponer en el cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clave de rol de servicio (SOLO para uso en servidor — nunca expongas esto en el cliente)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Webhooks — string random propio, usado por api/webhooks/cotizacion
WEBHOOK_SECRET=

# Token de PRODUCCIÓN de MercadoPago (APP_USR-...)
# Se obtiene en https://www.mercadopago.com.ar/developers/panel
MERCADOPAGO_ACCESS_TOKEN=

# Google Calendar — ver instrucciones para generarlas con OAuth Playground
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=       # vacío = usa el calendario principal de la cuenta autorizada
